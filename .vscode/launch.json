    "version": "0.2.0",
    "configurations": [
        {    
            "name": "Frame-FlirMultiCamera",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/record_synchronized_frame",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {    
            "name": "Videos-FlirMultiCamera",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/record_synchronized_videos",
            "args": ["/home/docker/workspace/build/dependencies/FlirMultiCamera/cfg/1024x768_example.json"],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }

    ]
}
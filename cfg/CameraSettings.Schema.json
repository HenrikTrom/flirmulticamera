{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
      "fps": { "type": "number" },
      "img_width": { "type": "integer" },
      "img_height": { "type": "integer" },
      "video_mode": { "type": "string" },
      "binning_vertical": { "type": "integer" },
      "pixel_format": { "type": "string" },
      "master_serial": { "type": "string" },
      "master_line": { "type": "string" },
      "slave_line": { "type": "string" },
      "save_dir": { "type": "string" },
      "cams": {
          "type": "array",
          "items": {
              "type": "object",
              "properties": {
                  "serial": { "type": "string" },
                  "black_level": { "type": "number" },
                  "gain": { "type": "number" },
                  "exposure_time": { "type": "number" }
              },
              "required": ["serial", "black_level", "gain", "exposure_time"]
          }
      }
  },
  "required": [
      "fps",
      "img_width",
      "img_height",
      "video_mode",
      "binning_vertical",
      "pixel_format",
      "master_serial",
      "master_line",
      "slave_line",
      "cams",
      "save_dir"
  ]
}